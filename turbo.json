{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "SALT_ROUNDS",
        "REDIS_URL",
        "NEXT_PUBLIC_WS_URL",
        "REDIS_CHANNEL_ORDERBOOK_PREFIX",
        "REDIS_CHANNEL_TRADE_PREFIX"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL"]
    },
    "dev": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "SALT_ROUNDS",
        "NODE_ENV",
        "REDIS_URL",
        "REDIS_CHANNEL_ORDERBOOK_PREFIX",
        "REDIS_CHANNEL_TRADE_PREFIX"
      ],
      "persistent": true
    },
    "db:migrate": {
      "env": ["DATABASE_URL"]
    }
  }
}
