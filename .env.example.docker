# Copy this file to .env.docker at the repo root before running `docker compose up`.
# These values match the credentials docker-compose.yml's postgres/redis services use.
DATABASE_URL=postgresql://postgres:mypassword@postgres:5432/mydatabase
REDIS_URL=redis://redis:6379
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-secret
SALT_ROUNDS=10
NODE_ENV=development
WS_PORT=8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
REDIS_CHANNEL_ORDERBOOK_PREFIX=orderbook
REDIS_CHANNEL_TRADE_PREFIX=tradebook
