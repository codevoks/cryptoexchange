# Copy this file to .env at the repo root for running the apps directly with
# `npm run dev` (no Docker) against a locally running Postgres and Redis.
DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/mydatabase
REDIS_URL=redis://localhost:6379
# Generate a real secret with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-secret
SALT_ROUNDS=10
NODE_ENV=development
WS_PORT=8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
REDIS_CHANNEL_ORDERBOOK_PREFIX=orderbook
REDIS_CHANNEL_TRADE_PREFIX=tradebook
